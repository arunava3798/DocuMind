# ---- LLM ----
# LLM_BACKEND: gemini | ollama
LLM_BACKEND=gemini
GEMINI_MODEL=gemini-flash-lite-latest
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/generate
# Get a free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# ---- Embeddings ----
# EMBEDDING_BACKEND: local (sentence-transformers) | api (Gemini embedContent)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_LOCAL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_API=gemini-embedding-001

# ---- Retrieval / chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# ---- Retrieval quality ----
# RETRIEVAL_MODE: dense | hybrid (hybrid = dense pgvector + Postgres full-text, fused with RRF)
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=20
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MULTI_QUERY_ENABLED=true
NUM_QUERIES=3

# ---- Storage ----
INDEX_DIR=index

# ---- Database (Postgres + pgvector) ----
# Neon free tier: https://neon.tech  (copy the connection string)
# Example: postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=
PG_COLLECTION_NAME=rag_documents

# ---- Observability ----
LOG_LEVEL=INFO
LOG_JSON=true
# Estimated Gemini pricing (USD per 1M tokens) for cost reporting only
GEMINI_INPUT_COST_PER_MTOK=0.10
GEMINI_OUTPUT_COST_PER_MTOK=0.40


